# All variables are Nuxt runtime-config overrides (NUXT_* convention) —
# no code reads process.env directly. Copy to .env for local dev; in
# production set them as Cloudflare Worker secrets (wrangler secret put).

# Notion integration token (https://developers.notion.com/docs/create-a-notion-integration)
NUXT_NUXT_NOTION_API_KEY=

# Notion data source id of the blog database (locks the /api/_notion proxy to it)
NUXT_NUXT_NOTION_DATA_SOURCE_ID=

# Spotify "now playing" widget (https://developer.spotify.com/dashboard)
NUXT_SPOTIFY_CLIENT_ID=
NUXT_SPOTIFY_CLIENT_SECRET=
NUXT_SPOTIFY_REFRESH_TOKEN=

# Cloudflare KV namespace id used for the server cache — build-time only,
# needed when building for deployment (not a secret).
NUXT_HUB_CACHE_NAMESPACE_ID=
